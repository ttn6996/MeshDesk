# MeshDesk Environment Configuration Template
# Copy this file to .env and configure as needed. Never commit actual secret keys or credentials.

# Application Environment (development | production)
MESHDESK_ENV=development

# Desktop Client Settings
MESHDESK_LOG_LEVEL=info
MESHDESK_BIND_HOST=127.0.0.1
MESHDESK_LOCAL_PORT=48120

# LAN Discovery Settings (UDP Broadcast / mDNS)
MESHDESK_ENABLE_LAN_DISCOVERY=true
MESHDESK_LAN_DISCOVERY_PORT=48121

# Signaling Service URL (Default local test server)
MESHDESK_SIGNALING_URL=ws://127.0.0.1:48122/ws

# STUN / TURN Server Configuration (Public ICE servers)
MESHDESK_STUN_SERVER=stun:stun.l.google.com:19302
MESHDESK_TURN_SERVER=
MESHDESK_TURN_USERNAME=
MESHDESK_TURN_PASSWORD=
